# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500

# Firebase: 로컬은 경로, 배포(Render)는 JSON 문자열 한 줄 중 하나만 설정
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# CORS 허용 도메인 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app
